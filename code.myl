import("library");
w=library.Window("lol", 950, 700);
w.fill(255,255,0);
w.present();
running=1;
for (;running;){
    events=library.GetEvents();
    for (i=0;i<events.size();i=i+1){
        if (events[i].type=="QUIT"){ 
            print("QUIT GET");
            running=0;
            break;
        };
    };
    w.fill(255,255,0);
    w.present();
};