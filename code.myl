import("library", "lib");
func(CreateSprite)(){
    n=newObject();
    n.rect=lib.Rect(0,0,0,0);
    n.hp=100;
    return(n);
};
aa=5;
aa*=10;
print(aa);
w=lib.Window("lol", 950, 700);
w.fill(255,255,0);
w.present();
running=1;
rr=lib.Rect(0,0,100,100);
txt=lib.CreateTexture(w, "amogus.png");
for (;running;){
    dt=lib.getDelta();
    events=lib.GetEvents();
    for (i=0;i<events.size();i=i+1){
        if (events[i].type=="QUIT"){ 
            print("QUIT GET");
            running=0;
            break;
        };
    };
    if (lib.isPressed("D")){
        rr.x=rr.x+300*dt;
    };
    if (lib.isPressed("A")){
        rr.x=rr.x-300*dt;
    };
    if (lib.isPressed("S")){
        rr.y=rr.y+300*dt;
    };
    if (lib.isPressed("W")){
        rr.y=rr.y-300*dt;
    };
    if (lib.isPressed("Q")){ 
        print("Q is pressed");
        running=0;
    };
    w.fill(255,255,0);
    txt.Draw(rr);
    w.present();
};