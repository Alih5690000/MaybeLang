import("library", "lib");
w=lib.Window("lol", 1000, 800);
w.SetFullscreen(1);
argg=GetArgs();
if (argg.size()==0){
    argg.push_back("null");
};
running=1;
txt=lib.CreateTexture(w, "amogus.png");
txt.flip=lib.FLIP_HORIZONTAL;
rr=lib.Rect(0, 0, 1000, 800);
func(ah)(arg){
    return(1);
};
func(aa)(ev){
    if (ev==lib.CONSOLE_CTRL_C){
        cmd("start ./m c.myl Child");
    };
};
lib.SetConsoleHook(aa);
w.GrabMouse(1);
lib.SetEventHook(ah);
acc=0;
for (;running;){
    dt=lib.getDelta();
    acc+=dt;
    if ((!w.IsFocused()) && (argg[0]!="Child")){
        cmd("start ./m c.myl Child");
        w.RaiseAbove();
    };
    if (acc>5){
        running=0;
    };
    events=lib.GetEvents();
    txt.Draw(rr);
    w.present();
};