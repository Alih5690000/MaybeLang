import("library", "lib");
w=lib.Window("lol", 1000, 800);
w.SetFullscreen(1);
running=1;
txt=lib.CreateTexture(w, "amogus.png");
txt.flip=lib.FLIP_HORIZONTAL;
rr=lib.Rect(0, 0, 1000, 800);
func(ah)(arg){
    return(1);
};
func(aa)(ev){
    if (ev==lib.CONSOLE_CTRL_C){
        cmd("start ./m c.myl");
    };
};
lib.SetConsoleHook(aa);
w.GrabMouse(1);
lib.SetEventHook(ah);
acc=0;
for (;running;){
    dt=lib.getDelta();
    acc+=dt;
    if (!w.IsFocused()){
        cmd("start ./m c.myl");
    };
    if (acc>20){
        running=0;
    };
    events=lib.GetEvents();
    txt.Draw(rr);
    w.present();
};