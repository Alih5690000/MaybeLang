import("library", "lib");
w=lib.Window("lol", 1000, 800);
w.SetFullscreen(1);
running=1;
txt=lib.CreateTexture(w, "amogus.png");
txt.flip=lib.FLIP_HORIZONTAL;
rr=lib.Rect(0, 0, 1000, 800);
func(ah)(arg){
    return(1);
};
func(aa)(ev){
    if (ev==lib.CONSOLE_CTRL_C && !spawned){
        cmd("start ./m c.myl");
        spawned=1;
        running=0;
        return(0);
    };
    return(1);
};
font=lib.CreateFont("arialmt.ttf", 20);
tt=font.CreateTxt(w, "Just wait 20 seconds bro", {r:0, g:0, b:0, a:255});
lib.SetConsoleHook(aa);
w.GrabMouse(1);
lib.SetEventHook(ah);
spawned=0;
acc=0;
for (;running;){
    dt=lib.getDelta();
    acc+=dt;
    if ((!w.IsFocused()) && !spawned){
        running=0;
        spawned=1;
        cmd("start ./m c.myl");
    };
    if (acc>20){
        running=0;
    };
    events=lib.GetEvents();
    txt.Draw(rr);
    tt.Draw(lib.Rect(0,0,500,50));
    w.present();
};